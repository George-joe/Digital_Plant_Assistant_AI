# GrowZen — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to GitHub.

# Flask secret key (generate a strong random string for production)
SECRET_KEY=your-strong-random-secret-key-here

# Database (default: SQLite for local dev; use PostgreSQL URL for production)
DATABASE_URL=sqlite:///database.db

# PlantNet API — plant identification
# Get your key at: https://my.plantnet.org/
PLANTNET_API_KEY=your_plantnet_api_key_here

# Groq API — AI chatbot (llama-3.3-70b-versatile)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OpenWeather API — weather widget
# Get your key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Telegram Bot — reminders and notifications
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Plant disease AI model path (relative to project root)
PLANT_DISEASE_MODEL_PATH=ai/plant-disease-model/model/plant_disease_model.keras
